{
  "name": "eshyra",
  "description": "Text-first persistent AI Dungeon Master for long-running fantasy campaigns.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbongaarts/eshyra.git"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p packages/core/scripts/tsconfig.json",
    "pretest": "tsc --build",
    "test": "vitest run",
    "smoke:cli-install": "node scripts/smoke-cli-install.mjs",
    "release:build": "node scripts/release/build-release-artifact.mjs",
    "release:validate": "node scripts/release/validate-release-artifact.mjs",
    "release:checksums": "node scripts/release/generate-checksums.mjs",
    "release:smoke-installer": "node scripts/release/smoke-installer.mjs",
    "release:smoke-clean-env": "bash scripts/release/clean-env-smoke.sh",
    "import:dnd5e-srd": "tsx packages/core/scripts/importers/dnd5e-srd-5.1/cli.ts",
    "verify:dnd5e-srd-pack": "tsx packages/core/scripts/verify-dnd5e-srd-pack/cli.ts",
    "verify:dnd5e-srd-freeze": "tsx packages/core/scripts/verify-dnd5e-srd-freeze/cli.ts",
    "generate:dnd5e-srd-creature-names": "tsx packages/core/scripts/generate-creature-name-baseline/cli.ts",
    "audit:rules-pack": "tsx packages/core/scripts/rules-pack-audit/cli.ts audit",
    "diff:rules-pack": "tsx packages/core/scripts/rules-pack-audit/cli.ts diff",
    "audit-bundle:dnd5e-srd": "tsx packages/core/scripts/create-dnd5e-srd-audit-bundle/cli.ts",
    "beads:sync": "node scripts/beads-sync.mjs",
    "agent:preflight": "node scripts/agent-preflight-main.mjs",
    "verify:worktree": "node scripts/verify-current-worktree.mjs",
    "verify:worktree:sandbox": "node scripts/verify-current-worktree.mjs --sandbox",
    "format": "biome check --write .",
    "format:check": "biome check --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "check:hidden-unicode": "node scripts/check-hidden-unicode.mjs",
    "check": "npm run check:hidden-unicode && biome ci --error-on-warnings .",
    "audit:dnd5e-srd-deep": "tsx packages/core/scripts/deep-audit-dnd5e-srd/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
