{
  "name": "@eshyra/core",
  "version": "0.0.0",
  "description": "UI-agnostic Eshyra campaign engine, persistence, rules, and model orchestration.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "files": [
    "dist",
    "data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbongaarts/eshyra.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "schema:snapshot": "tsx scripts/generate-schema-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@openai/codex-sdk": "0.142.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/pdfkit": "^0.17.6",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.19.1",
    "tsx": "^4.23.0"
  }
}
